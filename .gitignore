# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build
/dist
/*.egg-info

# python
__pycache__/
*.py[cod]

# Vouqis CLI output
/vouqis-verify-report.md

# misc
.DS_Store
*.pem
/awesome-codex-skills/

# local agent/tool state and scratch output — never ship to a public repo
/.claude/
/.claude-flow/
/.impeccable/
/.pnpm-store/
/.serena/
/.tmp-fixture-repo/
/outputs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
