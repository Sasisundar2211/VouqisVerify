# GitHub App (created manually in GitHub Developer Settings; permissions:
# Metadata read, Pull requests read, Checks read, Commit statuses read.
# Contents read is NOT required — the app never reads file contents, only
# the list of changed paths, which is covered by the Pull requests scope.)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's URL-friendly slug (from the GitHub App settings page), used to
# build https://github.com/apps/<slug>/installations/new.
GITHUB_APP_SLUG=
# Random secret used to sign/encrypt the session cookie. Generate with
# `openssl rand -base64 32`. Must be different from GITHUB_APP_CLIENT_SECRET.
SESSION_SECRET=
# Base URL this app is served from (used to build the OAuth callback URL).
# Local dev: http://localhost:3000. Production: your deployed origin, e.g.
# https://vouqis-verify.vercel.app. For public hosts the app ignores leftover
# localhost values and falls back to the origin the user actually visited, so
# the OAuth callback always targets the host they are on — but the GitHub App
# callback URL must list that origin too.
NEXT_PUBLIC_APP_URL=http://localhost:3000
